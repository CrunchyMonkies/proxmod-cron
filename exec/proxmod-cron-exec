#!/usr/bin/perl

use strict;
use warnings;

use Fcntl qw(LOCK_EX LOCK_NB);
use IO::Select ();
use POSIX ();
use Time::HiRes ();

use ProxmodCron::Cluster;
use ProxmodCron::Config;
use ProxmodCron::Journal;
use ProxmodCron::Lease;
use ProxmodCron::Spec;
use ProxmodCron::State;

# The run wrapper. Every job with track: true renders through it, every
# cluster-scoped job renders through it, and it is the only thing that writes run
# records.
#
#   proxmod-cron-exec <scope> <jobid> [--no-output] [--type <type>]
#                     [--require-quorum] [--once --schedule <spec>] [--no-record]
#                     -- <argv...>
#
# It is also where every decision that can only be made at fire time is made,
# because a rendered cron file is a statement about the last minute and this runs
# in this one:
#
#   * --require-quorum: a node that cannot confirm the cluster configuration it
#     is acting on stands down. Every cluster-scoped job gets this.
#   * --once --schedule: exactly one node in the cluster runs this tick. The
#     others lose the race and stand down. See ProxmodCron::Lease.
#   * --no-record: guards only. An untracked cluster job needs the guards and
#     nothing else, and must otherwise behave exactly as it did unwrapped — no
#     run lock, no history, output straight through to cron.
#
# EVERY STAND-DOWN IS A JOURNAL RECORD, including under --no-record. "It did not
# run" and "it ran and did nothing" look identical afterwards otherwise, which is
# the one thing that would make a job that moves between nodes impossible to
# reason about.
#
# Four properties that are easy to get wrong, all of them here:
#
#   * It NEVER STOPS DRAINING THE PIPES. Once the line cap is reached it stops
#     forwarding but keeps reading, because a full pipe blocks the child
#     forever. A capped run must still finish.
#   * It never alters what the job returned. A child killed by a signal makes
#     this process die of the same signal, so cron's view of success matches
#     reality instead of seeing a clean exit 0.
#   * A logging failure is not a job failure. ProxmodCron::Journal always
#     succeeds; nothing here turns a working backup into a failed one because a
#     socket was missing.
#   * The start record is emitted before the fork, so a job that dies instantly
#     still leaves a trace.
#
# Standalone by design: this loads no proxmod and no PVE. Disabling proxmod
# stops management, not execution and not tracking.

our $VERSION = '202608.17.0';

# Defaults; overridable per node via max_lines / max_line_bytes in
# /etc/proxmod/cron.cfg.
my $MAX_LINES = 10_000;
my $MAX_LINE_BYTES = 16 * 1024;

my $READ_CHUNK = 65_536;

# Position in this run's output, on every entry we send. A process runs exactly
# one job, so a script-level counter is the whole of it.
#
# Not for ordering — for absence. journald rate-limits per service, so entries
# can be dropped, and until this existed a run whose middle went missing came
# back as a shorter run with nothing to say so. A hole in the sequence is what
# lets the reader say "12 lines missing" instead of quietly showing 988 of 1000.
my $SEQ = 0;

exit(main(@ARGV));

sub main {
    my @args = @_;

    my $opt = parse_args(@args);

    my ($scope, $id) = ($opt->{scope}, $opt->{id});

    # The type comes in on the command line rather than out of the store. The
    # renderer put it there alongside the argv it derived from that same type, so
    # the two cannot disagree, and the wrapper stays free of a store read it
    # would have to degrade around on every single run.
    my $job = {
        id => $id,
        scope => $scope,
        type => $opt->{type},
    };

    load_limits();

    # Guard order: quorum, then the tick lease, then the run lock. Widest
    # question first — there is no point racing for a lease inside a partition
    # we have already established this node should not be acting on.
    my $cluster;
    if ($opt->{require_quorum}) {
        $cluster = ProxmodCron::Cluster::status();
        my ($ok, $why) = ProxmodCron::Cluster::quorate($cluster);
        return stand_down($job, $why) if !$ok;
    }

    my $run = run_id();

    my $tick;
    if ($opt->{once}) {
        $tick = ProxmodCron::Spec::tick($opt->{schedule});

        my ($result, $why) = ProxmodCron::Lease::acquire($id, $tick,
            node => ProxmodCron::Cluster::nodename($cluster),
            run => $run,
        );

        return stand_down($job,
            "another node has already claimed this run", tick => $tick)
            if $result eq 'taken';

        return stand_down($job, $why, tick => $tick) if $result ne 'won';
    }

    # An untracked job takes no run lock, exactly as it took none before the
    # guards put it in a wrapper. Its overlap behaviour is its own business.
    my ($lock, $busy) = $opt->{record} ? take_lock($scope, $id) : (undef, 0);
    if ($busy) {
        # A slow job must not stack up. A recorded skip is far better than a
        # silent one.
        note_lease($id, $tick, { state => 'skipped', finished => time() });
        return stand_down($job, 'a previous run is still in progress');
    }

    return run_unrecorded($job, $opt, $tick) if !$opt->{record};

    my $argv = $opt->{argv};
    my $keep_output = $opt->{keep_output};

    my $started = Time::HiRes::time();

    ProxmodCron::Journal::send_entry({
        %{ ProxmodCron::Journal::job_fields($job) },
        MESSAGE_ID => $ProxmodCron::Journal::MESSAGE_ID{start},
        PROXMOD_CRON_EVENT => 'start',
        PROXMOD_CRON_RUN => $run,
        PROXMOD_CRON_STARTED => int($started),
        MESSAGE => "started $scope job '$id': " . join(' ', @$argv),
    });

    my ($status, $captured) = supervise($job, $run, $argv, $keep_output);

    my $duration_ms = int((Time::HiRes::time() - $started) * 1000);

    my $exit = $status >> 8;
    my $signal = $status & 127;

    ProxmodCron::Journal::send_entry({
        %{ ProxmodCron::Journal::job_fields($job) },
        MESSAGE_ID => $ProxmodCron::Journal::MESSAGE_ID{finish},
        PROXMOD_CRON_EVENT => 'finish',
        PROXMOD_CRON_RUN => $run,
        # Both records carry the wrapper's own start time. journald's receive
        # timestamp is a different clock reading of the same instant and can land
        # a second either side of it, which is enough to make a rebuilt cache
        # disagree with the one written here — see ProxmodCron::Runs::fold.
        PROXMOD_CRON_STARTED => int($started),
        PROXMOD_CRON_EXIT => $exit,
        PROXMOD_CRON_SIGNAL => $signal,
        PROXMOD_CRON_DURATION_MS => $duration_ms,
        PROXMOD_CRON_LINES => $captured->{lines},
        PROXMOD_CRON_TRUNCATED => ($captured->{truncated} ? 1 : 0),
        PRIORITY => (($exit == 0 && !$signal) ? 6 : 3),
        MESSAGE => finish_message($scope, $id, $exit, $signal, $duration_ms),
    });

    ProxmodCron::State::record($scope, $id, {
        run => $run,
        started => int($started),
        finished => int($started) + int($duration_ms / 1000),
        exit => $exit,
        signal => $signal,
        duration_ms => $duration_ms,
        lines => $captured->{lines},
        truncated => ($captured->{truncated} ? 1 : 0),
        state => (($signal) ? 'killed' : ($exit == 0 ? 'ok' : 'failed')),
        tail => $captured->{tail},
    });

    note_lease($id, $tick, {
        state => (($signal) ? 'killed' : ($exit == 0 ? 'ok' : 'failed')),
        finished => int($started) + int($duration_ms / 1000),
        exit => $exit,
        signal => $signal,
        duration_ms => $duration_ms,
    });

    # Re-raise rather than exit. cron decides whether a job succeeded from the
    # wait status, and a SIGKILLed job that exits 0 here would be recorded as a
    # success by every other tool on the host.
    if ($signal) {
        close($lock) if $lock;
        kill($signal, $$);
        # Only reached if the signal was somehow ignored.
        POSIX::_exit(128 + $signal);
    }

    return $exit;
}

# A stand-down: the job did not run, and the journal says why. Always exit 0 —
# nothing failed, and telling cron otherwise would mail the administrator about
# a working cluster every minute.
sub stand_down {
    my ($job, $why, %extra) = @_;

    $why = 'no reason given' if !defined $why || $why eq '';

    ProxmodCron::Journal::send_entry({
        %{ ProxmodCron::Journal::job_fields($job) },
        MESSAGE_ID => $ProxmodCron::Journal::MESSAGE_ID{skipped},
        PROXMOD_CRON_EVENT => 'skipped',
        (defined $extra{tick} ? (PROXMOD_CRON_TICK => $extra{tick}) : ()),
        PRIORITY => 4,
        MESSAGE => "skipped $job->{scope} job '$job->{id}': $why",
    });

    return 0;
}

sub note_lease {
    my ($id, $tick, $fields) = @_;

    return if !defined $tick;

    ProxmodCron::Lease::note($id, $tick, $fields);

    return;
}

# --no-record: the guards ran, and from here the job behaves exactly as it did
# when it was not wrapped at all. Output goes wherever ours goes, which for cron
# means the same mail it always did.
sub run_unrecorded {
    my ($job, $opt, $tick) = @_;

    my $started = Time::HiRes::time();

    my $status = run_unwatched($opt->{argv});

    my $exit = $status >> 8;
    my $signal = $status & 127;

    note_lease($job->{id}, $tick, {
        state => (($signal) ? 'killed' : ($exit == 0 ? 'ok' : 'failed')),
        finished => int(Time::HiRes::time()),
        exit => $exit,
        signal => $signal,
        duration_ms => int((Time::HiRes::time() - $started) * 1000),
    });

    if ($signal) {
        kill($signal, $$);
        POSIX::_exit(128 + $signal);
    }

    return $exit;
}

sub parse_args {
    my @args = @_;

    my ($scope, $id, $type, $schedule);
    my $keep_output = 1;
    my $require_quorum = 0;
    my $once = 0;
    my $record = 1;
    my @argv;
    my $seen_separator = 0;

    while (@args) {
        my $arg = shift @args;

        if ($arg eq '--') {
            $seen_separator = 1;
            @argv = @args;
            last;
        }

        if ($arg eq '--no-output') {
            $keep_output = 0;
            next;
        }

        if ($arg eq '--require-quorum') {
            $require_quorum = 1;
            next;
        }

        if ($arg eq '--once') {
            $once = 1;
            next;
        }

        if ($arg eq '--no-record') {
            $record = 0;
            next;
        }

        if ($arg eq '--type') {
            $type = shift @args;
            usage("--type needs a value") if !defined $type;
            next;
        }

        if ($arg eq '--schedule') {
            $schedule = shift @args;
            usage("--schedule needs a value") if !defined $schedule;
            next;
        }

        if (!defined $scope) { $scope = $arg; next }
        if (!defined $id) { $id = $arg; next }

        usage("unexpected argument '$arg'");
    }

    usage('missing scope') if !defined $scope;
    usage('missing job id') if !defined $id;
    usage("expected '--' before the command") if !$seen_separator;
    usage('no command given') if !@argv;

    # Untaint both by pattern and rebuild: they reach a lock path, a journal
    # field and, in the case of the scope, a config lookup.
    my ($clean_scope) = ($scope =~ /\A(cluster|node)\z/);
    usage("invalid scope '$scope'") if !defined $clean_scope;

    my ($clean_id) = ($id =~ $ProxmodCron::Config::ID_PATTERN);
    usage("invalid job id '$id'") if !defined $clean_id;

    # A type that does not look like a type is dropped rather than fatal: the
    # job still has to run, and the worst case is one absent field on its
    # records.
    my $clean_type;
    ($clean_type) = ($type =~ $ProxmodCron::Config::ID_PATTERN) if defined $type;

    # The schedule reaches ProxmodCron::Spec, which is a parser and not an
    # evaluator, but it also reaches a directory name via the tick it produces.
    my $clean_schedule;
    ($clean_schedule) = ($schedule =~ m{\A([\@\w\*/,\- ]{1,128})\z})
        if defined $schedule;

    usage('--once needs --schedule') if $once && !defined $clean_schedule;

    return {
        scope => $clean_scope,
        id => $clean_id,
        type => $clean_type,
        keep_output => $keep_output,
        require_quorum => $require_quorum,
        once => $once,
        schedule => $clean_schedule,
        record => $record,
        argv => \@argv,
    };
}

sub usage {
    my ($why) = @_;
    print STDERR "proxmod-cron-exec: $why\n";
    print STDERR "usage: proxmod-cron-exec <cluster|node> <jobid> [--no-output]"
        . " [--type <type>] [--require-quorum] [--once --schedule <spec>]"
        . " [--no-record] -- <command> [args...]\n";
    exit(2);
}

sub load_limits {
    # The node store, whichever scope the job is in: these are limits on this
    # node's journald, not properties of the job.
    my $store = ProxmodCron::Config::load('node');

    $MAX_LINES = $store->{max_lines} if $store->{max_lines};
    $MAX_LINE_BYTES = $store->{max_line_bytes} if $store->{max_line_bytes};

    return;
}

# Returns ($handle, $busy). $busy means another run of this job holds the lock;
# an undef handle with $busy false means we could not lock at all, in which case
# we still run the job — the lock is overlap protection, not a precondition for
# doing the work.
sub take_lock {
    my ($scope, $id) = @_;

    my $dir = ProxmodCron::Config::state_dir();
    eval { ProxmodCron::Config::mkdir_p($dir) };

    my $path = ProxmodCron::Config::job_lock_path($scope, $id);

    open(my $fh, '>>', $path) or return (undef, 0);

    return (undef, 1) if !flock($fh, LOCK_EX | LOCK_NB);

    return ($fh, 0);
}

# Sortable and unique without pulling in a UUID module: milliseconds since the
# epoch, then four random bytes for the case where two runs of different jobs
# land in the same millisecond.
sub run_id {
    my $ms = int(Time::HiRes::time() * 1000);

    my $hex;
    if (open(my $fh, '<', '/dev/urandom')) {
        binmode($fh);
        my $bytes = '';
        read($fh, $bytes, 4);
        close($fh);
        $hex = unpack('H8', $bytes) if length($bytes) == 4;
    }

    $hex = sprintf('%04x%04x', $$ & 0xffff, int(rand(0x10000))) if !defined $hex;

    return "$ms-$hex";
}

sub finish_message {
    my ($scope, $id, $exit, $signal, $duration_ms) = @_;

    return "$scope job '$id' was killed by signal $signal after ${duration_ms}ms"
        if $signal;

    return "$scope job '$id' finished in ${duration_ms}ms" if $exit == 0;

    return "$scope job '$id' exited $exit after ${duration_ms}ms";
}

# Fork the job, forward its output, and wait. Returns (wait status, capture).
sub supervise {
    my ($job, $run, $argv, $keep_output) = @_;

    my ($out_r, $out_w, $err_r, $err_w);

    if (!pipe($out_r, $out_w) || !pipe($err_r, $err_w)) {
        # No pipes means no capture, but the job still has to run.
        return (run_unwatched($argv), { lines => 0, truncated => 0, tail => [] });
    }

    my $pid = fork();

    if (!defined $pid) {
        close($_) for ($out_r, $out_w, $err_r, $err_w);
        return (run_unwatched($argv), { lines => 0, truncated => 0, tail => [] });
    }

    if ($pid == 0) {
        close($out_r);
        close($err_r);

        open(STDOUT, '>&', $out_w) or POSIX::_exit(127);
        open(STDERR, '>&', $err_w) or POSIX::_exit(127);

        close($out_w);
        close($err_w);

        # No shell, ever. The argv arrives as an argv and is executed as one.
        { exec { $argv->[0] } @$argv; }

        print STDERR "proxmod-cron-exec: cannot execute $argv->[0]: $!\n";
        POSIX::_exit(127);
    }

    close($out_w);
    close($err_w);

    my $captured = pump($job, $run, $out_r, $err_r, $keep_output);

    waitpid($pid, 0);

    return ($?, $captured);
}

# Last resort when we could not set up the capture: run the job with its output
# going wherever ours goes. Losing the log is acceptable; not running the job is
# not.
sub run_unwatched {
    my ($argv) = @_;

    my $pid = fork();
    return 127 << 8 if !defined $pid;

    if ($pid == 0) {
        { exec { $argv->[0] } @$argv; }
        POSIX::_exit(127);
    }

    waitpid($pid, 0);

    return $?;
}

# Forward what the two pipes produce, in the order the kernel reports it.
#
# When only one pipe is ready, select has told us which stream arrived first and
# the recorded order is exact. When both are ready — a job that finished before
# we were scheduled, a burst — there is no information anywhere about their
# relative order, and this drains stdout first because that is the order
# IO::Select returns handles in.
#
# Do not "fix" that by alternating a line from each buffer. It would straighten
# out `echo a; echo b >&2` repeated and would scramble `echo 1; echo 2; echo 3
# >&2`, because it invents an ordering rather than reporting one. The ambiguity
# is real and it is documented; a plausible-looking guess would hide it.
#
# The order is usually destroyed before we ever see it in any case: glibc
# block-buffers stdout to a pipe and leaves stderr unbuffered, so a C program's
# stderr arrives immediately and its stdout arrives in blocks at exit. Nothing
# on this side of the pipe can recover that.
sub pump {
    my ($job, $run, $out_r, $err_r, $keep_output) = @_;

    my %buffer = ($out_r => '', $err_r => '');
    my %stream = ($out_r => 'stdout', $err_r => 'stderr');

    my $select = IO::Select->new($out_r, $err_r);

    my $lines = 0;
    my $truncated = 0;
    my @tail;

    while (my @ready = $select->can_read()) {
        for my $fh (@ready) {
            my $chunk = '';
            my $bytes = sysread($fh, $chunk, $READ_CHUNK);

            if (!defined $bytes) {
                next if $! == POSIX::EINTR();
                $select->remove($fh);
                next;
            }

            if ($bytes == 0) {
                $select->remove($fh);
                # Whatever is left without a trailing newline is still a line
                # the job wrote, and dropping it would silently lose the last
                # thing a crashing job said.
                if (length $buffer{$fh}) {
                    ($lines, $truncated) = emit(
                        $job, $run, $stream{$fh}, $buffer{$fh}, $keep_output,
                        $lines, $truncated, \@tail,
                    );
                    $buffer{$fh} = '';
                }
                next;
            }

            $buffer{$fh} .= $chunk;

            while ((my $nl = index($buffer{$fh}, "\n")) >= 0) {
                my $line = substr($buffer{$fh}, 0, $nl, '');
                substr($buffer{$fh}, 0, 1, '');
                ($lines, $truncated) = emit(
                    $job, $run, $stream{$fh}, $line, $keep_output,
                    $lines, $truncated, \@tail,
                );
            }

            # A job printing megabytes with no newline would otherwise grow this
            # buffer without bound. Cut it at the line cap and treat it as a
            # line; the job keeps running.
            #
            # A `while`, not an `if`: one read brings in up to $READ_CHUNK bytes,
            # which is larger than the line cap. Cutting once per read would
            # still leave the buffer growing by the difference on every pass —
            # unbounded growth at a slower rate, which is the same bug.
            while (length($buffer{$fh}) > $MAX_LINE_BYTES) {
                my $line = substr($buffer{$fh}, 0, $MAX_LINE_BYTES, '');
                ($lines, $truncated) = emit(
                    $job, $run, $stream{$fh}, $line, $keep_output,
                    $lines, $truncated, \@tail,
                );
            }
        }

        last if !$select->count();
    }

    close($out_r);
    close($err_r);

    return { lines => $lines, truncated => $truncated, tail => \@tail };
}

sub emit {
    my ($job, $run, $stream, $line, $keep_output, $lines, $truncated, $tail) = @_;

    $line =~ s/\r\z//;

    $lines++;

    # Past the cap we still counted the line and we still read it — the caller's
    # loop must keep draining or the child blocks forever — but nothing more is
    # forwarded, and exactly one truncation notice is recorded.
    if ($lines > $MAX_LINES) {
        if (!$truncated) {
            $truncated = 1;
            ProxmodCron::Journal::send_entry({
                %{ ProxmodCron::Journal::job_fields($job) },
                MESSAGE_ID => $ProxmodCron::Journal::MESSAGE_ID{output},
                PROXMOD_CRON_EVENT => 'output',
                PROXMOD_CRON_RUN => $run,
                PROXMOD_CRON_STREAM => $stream,
                # Numbered like any other entry we send: the sequence is dense
                # over what left this process, so a gap in it means the journal
                # lost something and nothing else.
                PROXMOD_CRON_SEQ => ++$SEQ,
                # Tagged because it is ours, not the job's. The log view shows it
                # like any other line; the output tail leaves it out, which is
                # what keeps a rebuilt tail identical to the one below.
                PROXMOD_CRON_NOTICE => 'truncated',
                PRIORITY => 4,
                MESSAGE => "[proxmod-cron] output truncated after $MAX_LINES lines",
            });
        }
        return ($lines, $truncated);
    }

    return ($lines, $truncated) if !$keep_output;

    $line = substr($line, 0, $MAX_LINE_BYTES) if length($line) > $MAX_LINE_BYTES;

    push @$tail, "$stream: $line";
    shift @$tail while @$tail > $ProxmodCron::State::TAIL_LINES;

    ProxmodCron::Journal::send_entry({
        %{ ProxmodCron::Journal::job_fields($job) },
        MESSAGE_ID => $ProxmodCron::Journal::MESSAGE_ID{output},
        PROXMOD_CRON_EVENT => 'output',
        PROXMOD_CRON_RUN => $run,
        PROXMOD_CRON_STREAM => $stream,
        PROXMOD_CRON_SEQ => ++$SEQ,
        PRIORITY => ($stream eq 'stderr' ? 4 : 6),
        MESSAGE => $line,
    });

    return ($lines, $truncated);
}
